run = ["node", "scripts/web-server.js"]
modules = ["nodejs-20"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/web-server.js"
waitForPort = 5000
